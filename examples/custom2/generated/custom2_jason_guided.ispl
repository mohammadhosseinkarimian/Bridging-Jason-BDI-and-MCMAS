Semantics=SingleAssignment;

Agent Environment
    Obsvars:
        fb_area: {area_1, area_2};
        at_area: {area_1, area_2};
        civ_area: {area_1, area_2, in_ambulance};
        refuge_area: {area_1, area_2};
        civilian_Civ: boolean;
        building_1: boolean;
        brokenness_1: {healthy, damaged, collapsed};
        building_2: boolean;
        brokenness_2: {healthy, damaged, collapsed};
        all_roads_initially_clear: boolean;
        hp_Civ: 0 .. 7500;
        health_Civ: {complete, high, moderate, at_risk, dead};
        damage_Civ: {none, moderate};
        buriedness_value_Civ: 0 .. 6;
        alive_Civ: boolean;
        dead_Civ: boolean;
        loaded_Civ: boolean;
        delivered_Civ: boolean;
        fb_knows_buried_Civ: boolean;
        at_knows_buried_Civ: boolean;
        buried_Civ_reported_to_FB: boolean;
        Civ_ready_reported_to_AT: boolean;
        at_knows_refuge: boolean;
    end Obsvars
    Actions = {env_idle};
    Protocol:
        Other: {env_idle};
    end Protocol
    Evolution:
        -- Movement
        fb_area = area_1 if FireBrigade.Action = fb_move_to_1;
        fb_area = area_2 if FireBrigade.Action = fb_move_to_2;
        fb_area = fb_area if FireBrigade.Action = fb_notify_ambulance_ready_Civ;
        fb_area = fb_area if FireBrigade.Action = fb_rest;
        fb_area = fb_area if FireBrigade.Action = fb_rescue_Civ;
        at_area = area_1 if AmbulanceTeam.Action = at_move_to_1;
        at_area = area_2 if AmbulanceTeam.Action = at_move_to_2;
        at_area = at_area if AmbulanceTeam.Action = at_report_buried_Civ;
        at_area = at_area if AmbulanceTeam.Action = at_rest;
        at_area = at_area if AmbulanceTeam.Action = at_load_Civ;
        at_area = at_area if AmbulanceTeam.Action = at_unload_Civ;
        -- Rescue
        buriedness_value_Civ = 5 if alive_Civ = true and buriedness_value_Civ = 6 and civ_area = area_1 and fb_area = area_1 and FireBrigade.Action = fb_rescue_Civ;
        buriedness_value_Civ = 4 if alive_Civ = true and buriedness_value_Civ = 5 and civ_area = area_1 and fb_area = area_1 and FireBrigade.Action = fb_rescue_Civ;
        buriedness_value_Civ = 3 if alive_Civ = true and buriedness_value_Civ = 4 and civ_area = area_1 and fb_area = area_1 and FireBrigade.Action = fb_rescue_Civ;
        buriedness_value_Civ = 2 if alive_Civ = true and buriedness_value_Civ = 3 and civ_area = area_1 and fb_area = area_1 and FireBrigade.Action = fb_rescue_Civ;
        buriedness_value_Civ = 1 if alive_Civ = true and buriedness_value_Civ = 2 and civ_area = area_1 and fb_area = area_1 and FireBrigade.Action = fb_rescue_Civ;
        buriedness_value_Civ = 0 if alive_Civ = true and buriedness_value_Civ = 1 and civ_area = area_1 and fb_area = area_1 and FireBrigade.Action = fb_rescue_Civ;
        buriedness_value_Civ = 5 if alive_Civ = true and buriedness_value_Civ = 6 and civ_area = area_2 and fb_area = area_2 and FireBrigade.Action = fb_rescue_Civ;
        buriedness_value_Civ = 4 if alive_Civ = true and buriedness_value_Civ = 5 and civ_area = area_2 and fb_area = area_2 and FireBrigade.Action = fb_rescue_Civ;
        buriedness_value_Civ = 3 if alive_Civ = true and buriedness_value_Civ = 4 and civ_area = area_2 and fb_area = area_2 and FireBrigade.Action = fb_rescue_Civ;
        buriedness_value_Civ = 2 if alive_Civ = true and buriedness_value_Civ = 3 and civ_area = area_2 and fb_area = area_2 and FireBrigade.Action = fb_rescue_Civ;
        buriedness_value_Civ = 1 if alive_Civ = true and buriedness_value_Civ = 2 and civ_area = area_2 and fb_area = area_2 and FireBrigade.Action = fb_rescue_Civ;
        buriedness_value_Civ = 0 if alive_Civ = true and buriedness_value_Civ = 1 and civ_area = area_2 and fb_area = area_2 and FireBrigade.Action = fb_rescue_Civ;
        -- Load
        loaded_Civ = true if alive_Civ = true and dead_Civ = false and delivered_Civ = false and buriedness_value_Civ = 0 and loaded_Civ = false and civ_area = area_1 and at_area = area_1 and AmbulanceTeam.Action = at_load_Civ;
        civ_area = in_ambulance if alive_Civ = true and dead_Civ = false and delivered_Civ = false and buriedness_value_Civ = 0 and loaded_Civ = false and civ_area = area_1 and at_area = area_1 and AmbulanceTeam.Action = at_load_Civ;
        loaded_Civ = true if alive_Civ = true and dead_Civ = false and delivered_Civ = false and buriedness_value_Civ = 0 and loaded_Civ = false and civ_area = area_2 and at_area = area_2 and AmbulanceTeam.Action = at_load_Civ;
        civ_area = in_ambulance if alive_Civ = true and dead_Civ = false and delivered_Civ = false and buriedness_value_Civ = 0 and loaded_Civ = false and civ_area = area_2 and at_area = area_2 and AmbulanceTeam.Action = at_load_Civ;
        -- Unload
        loaded_Civ = false if loaded_Civ = true and alive_Civ = true and dead_Civ = false and delivered_Civ = false and at_area = area_1 and refuge_area = area_1 and AmbulanceTeam.Action = at_unload_Civ;
        delivered_Civ = true if loaded_Civ = true and alive_Civ = true and dead_Civ = false and delivered_Civ = false and at_area = area_1 and refuge_area = area_1 and AmbulanceTeam.Action = at_unload_Civ;
        civ_area = area_1 if loaded_Civ = true and alive_Civ = true and dead_Civ = false and delivered_Civ = false and at_area = area_1 and refuge_area = area_1 and AmbulanceTeam.Action = at_unload_Civ;
        loaded_Civ = false if loaded_Civ = true and alive_Civ = true and dead_Civ = false and delivered_Civ = false and at_area = area_2 and refuge_area = area_2 and AmbulanceTeam.Action = at_unload_Civ;
        delivered_Civ = true if loaded_Civ = true and alive_Civ = true and dead_Civ = false and delivered_Civ = false and at_area = area_2 and refuge_area = area_2 and AmbulanceTeam.Action = at_unload_Civ;
        civ_area = area_2 if loaded_Civ = true and alive_Civ = true and dead_Civ = false and delivered_Civ = false and at_area = area_2 and refuge_area = area_2 and AmbulanceTeam.Action = at_unload_Civ;
        -- Beliefs
        fb_knows_buried_Civ = true if fb_knows_buried_Civ = true or (alive_Civ = true and (buriedness_value_Civ = 1 or buriedness_value_Civ = 2 or buriedness_value_Civ = 3 or buriedness_value_Civ = 4 or buriedness_value_Civ = 5 or buriedness_value_Civ = 6) and civ_area = area_2 and (fb_area = area_2 or FireBrigade.Action = fb_move_to_2)) or buried_Civ_reported_to_FB = true;
        at_knows_buried_Civ = true if at_knows_buried_Civ = true or (alive_Civ = true and (buriedness_value_Civ = 1 or buriedness_value_Civ = 2 or buriedness_value_Civ = 3 or buriedness_value_Civ = 4 or buriedness_value_Civ = 5 or buriedness_value_Civ = 6) and civ_area = area_2 and (at_area = area_2 or AmbulanceTeam.Action = at_move_to_2));
        buried_Civ_reported_to_FB = true if buried_Civ_reported_to_FB = true or (at_knows_buried_Civ = true and AmbulanceTeam.Action = at_report_buried_Civ);
        Civ_ready_reported_to_AT = true if Civ_ready_reported_to_AT = true or (alive_Civ = true and buriedness_value_Civ = 0 and FireBrigade.Action = fb_notify_ambulance_ready_Civ);
        at_knows_refuge = true if at_knows_refuge = true or at_area = area_1 or AmbulanceTeam.Action = at_move_to_1;
        -- Fixed damage only while Civ remains buried in a collapsed building
        hp_Civ = 5000 if alive_Civ = true and delivered_Civ = false and ((civ_area = area_1 and brokenness_1 = collapsed) or (civ_area = area_2 and brokenness_2 = collapsed)) and (buriedness_value_Civ = 1 or buriedness_value_Civ = 2 or buriedness_value_Civ = 3 or buriedness_value_Civ = 4 or buriedness_value_Civ = 5 or buriedness_value_Civ = 6) and hp_Civ = 7500 and health_Civ = high;
        health_Civ = moderate if alive_Civ = true and delivered_Civ = false and ((civ_area = area_1 and brokenness_1 = collapsed) or (civ_area = area_2 and brokenness_2 = collapsed)) and (buriedness_value_Civ = 1 or buriedness_value_Civ = 2 or buriedness_value_Civ = 3 or buriedness_value_Civ = 4 or buriedness_value_Civ = 5 or buriedness_value_Civ = 6) and hp_Civ = 7500 and health_Civ = high;
        hp_Civ = 2500 if alive_Civ = true and delivered_Civ = false and ((civ_area = area_1 and brokenness_1 = collapsed) or (civ_area = area_2 and brokenness_2 = collapsed)) and (buriedness_value_Civ = 1 or buriedness_value_Civ = 2 or buriedness_value_Civ = 3 or buriedness_value_Civ = 4 or buriedness_value_Civ = 5 or buriedness_value_Civ = 6) and hp_Civ = 5000 and health_Civ = moderate;
        health_Civ = at_risk if alive_Civ = true and delivered_Civ = false and ((civ_area = area_1 and brokenness_1 = collapsed) or (civ_area = area_2 and brokenness_2 = collapsed)) and (buriedness_value_Civ = 1 or buriedness_value_Civ = 2 or buriedness_value_Civ = 3 or buriedness_value_Civ = 4 or buriedness_value_Civ = 5 or buriedness_value_Civ = 6) and hp_Civ = 5000 and health_Civ = moderate;
        hp_Civ = 0 if alive_Civ = true and delivered_Civ = false and ((civ_area = area_1 and brokenness_1 = collapsed) or (civ_area = area_2 and brokenness_2 = collapsed)) and (buriedness_value_Civ = 1 or buriedness_value_Civ = 2 or buriedness_value_Civ = 3 or buriedness_value_Civ = 4 or buriedness_value_Civ = 5 or buriedness_value_Civ = 6) and hp_Civ = 2500 and health_Civ = at_risk;
        health_Civ = dead if alive_Civ = true and delivered_Civ = false and ((civ_area = area_1 and brokenness_1 = collapsed) or (civ_area = area_2 and brokenness_2 = collapsed)) and (buriedness_value_Civ = 1 or buriedness_value_Civ = 2 or buriedness_value_Civ = 3 or buriedness_value_Civ = 4 or buriedness_value_Civ = 5 or buriedness_value_Civ = 6) and hp_Civ = 2500 and health_Civ = at_risk;
        alive_Civ = false if alive_Civ = true and delivered_Civ = false and ((civ_area = area_1 and brokenness_1 = collapsed) or (civ_area = area_2 and brokenness_2 = collapsed)) and (buriedness_value_Civ = 1 or buriedness_value_Civ = 2 or buriedness_value_Civ = 3 or buriedness_value_Civ = 4 or buriedness_value_Civ = 5 or buriedness_value_Civ = 6) and hp_Civ = 2500 and health_Civ = at_risk;
        dead_Civ = true if alive_Civ = true and delivered_Civ = false and ((civ_area = area_1 and brokenness_1 = collapsed) or (civ_area = area_2 and brokenness_2 = collapsed)) and (buriedness_value_Civ = 1 or buriedness_value_Civ = 2 or buriedness_value_Civ = 3 or buriedness_value_Civ = 4 or buriedness_value_Civ = 5 or buriedness_value_Civ = 6) and hp_Civ = 2500 and health_Civ = at_risk;
    end Evolution
end Agent

Agent FireBrigade
    Vars:
        dummy: boolean;
        fb_goal_level: {saved_civilians, rescued_buried_civilian, told_ambulance, done};
        fb_visited_area_1: boolean;
        fb_visited_area_2: boolean;
    end Vars
    Actions = {fb_move_to_1, fb_move_to_2, fb_rescue_Civ, fb_notify_ambulance_ready_Civ, fb_rest};
    Protocol:
        (Environment.dead_Civ = true or (Environment.alive_Civ = true and Environment.dead_Civ = false and Environment.loaded_Civ = false and Environment.buriedness_value_Civ = 0 and Environment.civ_area = area_1 and Environment.at_area = area_1 and Environment.refuge_area = area_1)): {fb_rest};
        fb_goal_level = done: {fb_rest};
        fb_goal_level = told_ambulance: {fb_notify_ambulance_ready_Civ};
        (fb_goal_level = saved_civilians or fb_goal_level = rescued_buried_civilian) and Environment.fb_knows_buried_Civ = true and Environment.alive_Civ = true and (Environment.buriedness_value_Civ = 1 or Environment.buriedness_value_Civ = 2 or Environment.buriedness_value_Civ = 3 or Environment.buriedness_value_Civ = 4 or Environment.buriedness_value_Civ = 5 or Environment.buriedness_value_Civ = 6) and Environment.fb_area = area_2: {fb_rescue_Civ};
        (fb_goal_level = saved_civilians or fb_goal_level = rescued_buried_civilian) and Environment.fb_knows_buried_Civ = true and Environment.alive_Civ = true and (Environment.buriedness_value_Civ = 1 or Environment.buriedness_value_Civ = 2 or Environment.buriedness_value_Civ = 3 or Environment.buriedness_value_Civ = 4 or Environment.buriedness_value_Civ = 5 or Environment.buriedness_value_Civ = 6) and Environment.fb_area = area_1:
            {fb_move_to_2};
        -- Patrol
        fb_goal_level = saved_civilians and Environment.fb_knows_buried_Civ = false and Environment.alive_Civ = true and Environment.fb_area = area_1 and fb_visited_area_2 = false:
            {fb_move_to_2};
        fb_goal_level = saved_civilians and Environment.fb_knows_buried_Civ = false and Environment.alive_Civ = true and Environment.fb_area = area_1 and fb_visited_area_2 = true:
            {fb_move_to_2};
        fb_goal_level = saved_civilians and Environment.fb_knows_buried_Civ = false and Environment.alive_Civ = true and Environment.fb_area = area_2 and fb_visited_area_1 = false:
            {fb_move_to_1};
        fb_goal_level = saved_civilians and Environment.fb_knows_buried_Civ = false and Environment.alive_Civ = true and Environment.fb_area = area_2 and fb_visited_area_1 = true:
            {fb_move_to_1};
        Other: {fb_rest};
    end Protocol
    Evolution:
        dummy = dummy if dummy = true;
        dummy = dummy if dummy = false;
        fb_goal_level = done if Environment.dead_Civ = true;
        fb_goal_level = done if Environment.loaded_Civ = true and Environment.alive_Civ = true and Environment.dead_Civ = false and Environment.delivered_Civ = false and Environment.at_area = area_1 and Environment.refuge_area = area_1 and AmbulanceTeam.Action = at_unload_Civ;
        fb_goal_level = told_ambulance if (fb_goal_level = saved_civilians or fb_goal_level = rescued_buried_civilian) and Environment.fb_knows_buried_Civ = true and Environment.alive_Civ = true and Environment.buriedness_value_Civ = 1 and Environment.fb_area = area_2 and FireBrigade.Action = fb_rescue_Civ;
        fb_goal_level = saved_civilians if fb_goal_level = told_ambulance and FireBrigade.Action = fb_notify_ambulance_ready_Civ and Environment.dead_Civ = false and Environment.delivered_Civ = false;
        fb_goal_level = rescued_buried_civilian if fb_goal_level = saved_civilians and Environment.fb_knows_buried_Civ = true and Environment.alive_Civ = true and (Environment.buriedness_value_Civ = 2 or Environment.buriedness_value_Civ = 3 or Environment.buriedness_value_Civ = 4 or Environment.buriedness_value_Civ = 5 or Environment.buriedness_value_Civ = 6);
        fb_goal_level = rescued_buried_civilian if fb_goal_level = rescued_buried_civilian and Environment.fb_knows_buried_Civ = true and Environment.alive_Civ = true and (Environment.buriedness_value_Civ = 2 or Environment.buriedness_value_Civ = 3 or Environment.buriedness_value_Civ = 4 or Environment.buriedness_value_Civ = 5 or Environment.buriedness_value_Civ = 6);
        -- Visited
        fb_visited_area_1 = true if fb_visited_area_1 = true or FireBrigade.Action = fb_move_to_1;
        fb_visited_area_2 = true if fb_visited_area_2 = true or FireBrigade.Action = fb_move_to_2;
    end Evolution
end Agent


Agent AmbulanceTeam
    Vars:
        dummy: boolean;
        at_goal_level: {saved_civilians, told_fire, loaded, delivered, done};
        at_visited_area_1: boolean;
        at_visited_area_2: boolean;
    end Vars
    Actions = {at_move_to_1, at_move_to_2, at_load_Civ, at_unload_Civ, at_report_buried_Civ, at_rest};
    Protocol:
        (Environment.dead_Civ = true or (Environment.alive_Civ = true and Environment.dead_Civ = false and Environment.loaded_Civ = false and Environment.buriedness_value_Civ = 0 and Environment.civ_area = area_1 and Environment.at_area = area_1 and Environment.refuge_area = area_1)): {at_rest};
        at_goal_level = done: {at_rest};
        at_goal_level = told_fire: {at_report_buried_Civ};
        at_goal_level = loaded and Environment.alive_Civ = true and Environment.loaded_Civ = false and Environment.buriedness_value_Civ = 0 and Environment.at_area = area_2: {at_load_Civ};
        at_goal_level = loaded and Environment.alive_Civ = true and Environment.loaded_Civ = false and Environment.buriedness_value_Civ = 0 and Environment.at_area = area_1:
            {at_move_to_2};
        at_goal_level = delivered and Environment.loaded_Civ = true and Environment.alive_Civ = true and Environment.at_area = area_1: {at_unload_Civ};
        at_goal_level = delivered and Environment.loaded_Civ = true and Environment.alive_Civ = true and Environment.at_knows_refuge = true and Environment.at_area = area_2:
            {at_move_to_1};
        at_goal_level = saved_civilians and Environment.at_knows_buried_Civ = true and Environment.alive_Civ = true and (Environment.buriedness_value_Civ = 1 or Environment.buriedness_value_Civ = 2 or Environment.buriedness_value_Civ = 3 or Environment.buriedness_value_Civ = 4 or Environment.buriedness_value_Civ = 5 or Environment.buriedness_value_Civ = 6) and Environment.fb_area = area_2: {at_rest};
        at_goal_level = saved_civilians and Environment.at_knows_buried_Civ = true and Environment.buried_Civ_reported_to_FB = false and Environment.alive_Civ = true and (Environment.buriedness_value_Civ = 1 or Environment.buriedness_value_Civ = 2 or Environment.buriedness_value_Civ = 3 or Environment.buriedness_value_Civ = 4 or Environment.buriedness_value_Civ = 5 or Environment.buriedness_value_Civ = 6) and (Environment.fb_area = area_1): {at_rest};
        at_goal_level = saved_civilians and Environment.at_knows_buried_Civ = true and Environment.buried_Civ_reported_to_FB = true and Environment.alive_Civ = true and (Environment.buriedness_value_Civ = 1 or Environment.buriedness_value_Civ = 2 or Environment.buriedness_value_Civ = 3 or Environment.buriedness_value_Civ = 4 or Environment.buriedness_value_Civ = 5 or Environment.buriedness_value_Civ = 6) and Environment.at_area = area_2: {at_rest};
        at_goal_level = saved_civilians and Environment.at_knows_buried_Civ = true and Environment.buried_Civ_reported_to_FB = true and Environment.alive_Civ = true and (Environment.buriedness_value_Civ = 1 or Environment.buriedness_value_Civ = 2 or Environment.buriedness_value_Civ = 3 or Environment.buriedness_value_Civ = 4 or Environment.buriedness_value_Civ = 5 or Environment.buriedness_value_Civ = 6) and Environment.at_area = area_1:
            {at_move_to_2, at_rest};
        at_goal_level = saved_civilians and Environment.alive_Civ = true and Environment.loaded_Civ = false and Environment.buriedness_value_Civ = 0 and (Environment.Civ_ready_reported_to_AT = true or Environment.at_area = area_2): {at_rest};
        -- Patrol
        at_goal_level = saved_civilians and Environment.at_knows_buried_Civ = false and Environment.alive_Civ = true and Environment.at_area = area_1 and at_visited_area_2 = false:
            {at_move_to_2};
        at_goal_level = saved_civilians and Environment.at_knows_buried_Civ = false and Environment.alive_Civ = true and Environment.at_area = area_1 and at_visited_area_2 = true:
            {at_move_to_2};
        at_goal_level = saved_civilians and Environment.at_knows_buried_Civ = false and Environment.alive_Civ = true and Environment.at_area = area_2 and at_visited_area_1 = false:
            {at_move_to_1};
        at_goal_level = saved_civilians and Environment.at_knows_buried_Civ = false and Environment.alive_Civ = true and Environment.at_area = area_2 and at_visited_area_1 = true:
            {at_move_to_1};
        Other: {at_rest};
    end Protocol
    Evolution:
        dummy = dummy if dummy = true;
        dummy = dummy if dummy = false;
        at_goal_level = done if Environment.dead_Civ = true;
        at_goal_level = done if at_goal_level = delivered and AmbulanceTeam.Action = at_unload_Civ;
        at_goal_level = delivered if at_goal_level = loaded and AmbulanceTeam.Action = at_load_Civ;
        at_goal_level = loaded if at_goal_level = saved_civilians and Environment.alive_Civ = true and Environment.loaded_Civ = false and Environment.buriedness_value_Civ = 1 and Environment.at_area = area_2 and Environment.fb_area = area_2 and FireBrigade.Action = fb_rescue_Civ;
        at_goal_level = loaded if at_goal_level = saved_civilians and Environment.alive_Civ = true and Environment.loaded_Civ = false and Environment.buriedness_value_Civ = 0 and (Environment.Civ_ready_reported_to_AT = true or Environment.at_area = area_2);
        at_goal_level = told_fire if at_goal_level = saved_civilians and Environment.at_knows_buried_Civ = true and Environment.buried_Civ_reported_to_FB = false and Environment.alive_Civ = true and (Environment.buriedness_value_Civ = 1 or Environment.buriedness_value_Civ = 2 or Environment.buriedness_value_Civ = 3 or Environment.buriedness_value_Civ = 4 or Environment.buriedness_value_Civ = 5 or Environment.buriedness_value_Civ = 6) and (Environment.fb_area = area_1);
        at_goal_level = saved_civilians if at_goal_level = told_fire and AmbulanceTeam.Action = at_report_buried_Civ;
        -- Visited
        at_visited_area_1 = true if at_visited_area_1 = true or AmbulanceTeam.Action = at_move_to_1;
        at_visited_area_2 = true if at_visited_area_2 = true or AmbulanceTeam.Action = at_move_to_2;
    end Evolution
end Agent


Evaluation
    Civ_complete if Environment.health_Civ = complete;
    Civ_high if Environment.health_Civ = high;
    Civ_moderate if Environment.health_Civ = moderate;
    Civ_at_risk if Environment.health_Civ = at_risk;
    Civ_dead if Environment.dead_Civ = true;
    Civ_deep if Environment.buriedness_value_Civ = 4 or Environment.buriedness_value_Civ = 5 or Environment.buriedness_value_Civ = 6;
    Civ_shallow if Environment.buriedness_value_Civ = 1 or Environment.buriedness_value_Civ = 2 or Environment.buriedness_value_Civ = 3;
    surface_alive_Civ_eval if Environment.alive_Civ = true and Environment.dead_Civ = false and Environment.buriedness_value_Civ = 0 and Environment.loaded_Civ = false and Environment.delivered_Civ = false;
    surface_Civ_eval if Environment.alive_Civ = true and Environment.dead_Civ = false and Environment.buriedness_value_Civ = 0 and Environment.loaded_Civ = false and Environment.delivered_Civ = false;
    loaded_Civ_eval if Environment.loaded_Civ = true;
    illegal_buried_load_eval if Environment.loaded_Civ = true and (Environment.buriedness_value_Civ = 1 or Environment.buriedness_value_Civ = 2 or Environment.buriedness_value_Civ = 3 or Environment.buriedness_value_Civ = 4 or Environment.buriedness_value_Civ = 5 or Environment.buriedness_value_Civ = 6);
    delivered_alive_Civ_eval if (Environment.delivered_Civ = true and Environment.alive_Civ = true and Environment.dead_Civ = false and Environment.loaded_Civ = false and Environment.civ_area = area_1 and Environment.at_area = area_1 and Environment.refuge_area = area_1) or (Environment.delivered_Civ = true and Environment.alive_Civ = true and Environment.dead_Civ = false and Environment.loaded_Civ = false and Environment.civ_area = area_2 and Environment.at_area = area_2 and Environment.refuge_area = area_2);
    terminal_dead_Civ_eval if Environment.dead_Civ = true;
    terminal_Civ_eval if (Environment.dead_Civ = true or ((Environment.alive_Civ = true and Environment.dead_Civ = false and Environment.loaded_Civ = false and Environment.buriedness_value_Civ = 0 and Environment.civ_area = area_1 and Environment.at_area = area_1 and Environment.refuge_area = area_1) or (Environment.alive_Civ = true and Environment.dead_Civ = false and Environment.loaded_Civ = false and Environment.buriedness_value_Civ = 0 and Environment.civ_area = area_2 and Environment.at_area = area_2 and Environment.refuge_area = area_2)));
end Evaluation

InitStates
    Environment.fb_area = area_1 and
    Environment.at_area = area_1 and
    Environment.civ_area = area_2 and
    Environment.refuge_area = area_1 and
    Environment.civilian_Civ = true and
    Environment.building_1 = true and
    Environment.brokenness_1 = healthy and
    Environment.building_2 = true and
    Environment.brokenness_2 = collapsed and
    Environment.all_roads_initially_clear = true and
    Environment.hp_Civ = 7500 and
    Environment.health_Civ = high and
    Environment.damage_Civ = moderate and
    Environment.buriedness_value_Civ = 1 and
    Environment.alive_Civ = true and
    Environment.dead_Civ = false and
    Environment.loaded_Civ = false and
    Environment.delivered_Civ = false and
    Environment.fb_knows_buried_Civ = false and
    Environment.at_knows_buried_Civ = false and
    Environment.buried_Civ_reported_to_FB = false and
    Environment.Civ_ready_reported_to_AT = false and
    Environment.at_knows_refuge = true and
    FireBrigade.fb_goal_level = saved_civilians and
    FireBrigade.fb_visited_area_1 = true and
    FireBrigade.fb_visited_area_2 = false and
    AmbulanceTeam.at_goal_level = saved_civilians and
    AmbulanceTeam.at_visited_area_1 = true and
    AmbulanceTeam.at_visited_area_2 = false and
    FireBrigade.dummy = false and
    AmbulanceTeam.dummy = false;
end InitStates

Groups
    fire_only = {FireBrigade};
    ambulance_only = {AmbulanceTeam};
    rescue_team = {FireBrigade, AmbulanceTeam};
end Groups

