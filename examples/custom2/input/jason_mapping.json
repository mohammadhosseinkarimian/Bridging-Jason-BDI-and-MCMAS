  "model": {
    "environment_agent": "Environment",
    "domain": {
      "enum_var": "fb_area",
      "value_regex": "area_\\d+",
      "token_regex": "area_(?P<id>\\d+)"
    },
    "anchors": {
      "focus": {
        "initial_var": "civ_area"
      },
      "endpoint": {
        "initial_var": "refuge_area"
      }
    },
    "variables": {
      "active": "alive_Civ",
      "failed": "dead_Civ",
      "holding": "loaded_Civ",
      "complete": "delivered_Civ",
      "level": "buriedness_value_Civ",
      "focus_state": "civ_area",
      "endpoint_state": "refuge_area"
    },
    "member_labels": {
      "default": "road",
      "rules": [
        {
          "declaration_regex": "\\bbuilding_{id}:\\s*boolean;",
          "state_regex": "Environment\\.brokenness_{id}\\s*=\\s*(?P<value>healthy|damaged|collapsed)",
          "value_map": {
            "healthy": "building",
            "damaged": "damaged",
            "collapsed": "collapsed"
          }
        }
      ]
    },
    "level": {
      "zero_value": 0,
      "final_value": 1,
      "positive_values": [
        1,
        2,
        3,
        4,
        5,
        6
      ],
      "continuing_values": [
        2,
        3,
        4,
        5,
        6
      ]
    }
  },
  "format": {
    "actions_indent": 12,
    "actions_per_line": 6,
    "path_indent": 16,
    "path_actions_per_line": 4
  },
  "coordination": {
    "primary_role": "role_a",
    "secondary_role": "role_b",
    "primary_knows_focus_var": "fb_knows_buried_Civ",
    "secondary_knows_focus_var": "at_knows_buried_Civ",
    "focus_report_flag_var": "buried_Civ_reported_to_FB",
    "ready_flag_var": "Civ_ready_reported_to_AT",
    "secondary_knows_endpoint_var": "at_knows_refuge",
    "primary_action_key": "work",
    "primary_signal_action_key": "notify",
    "secondary_signal_action_key": "report",
    "secondary_take_action_key": "acquire",
    "secondary_finish_action_key": "finish",
    "idle_action_key": "rest",
    "focus_name": "focus",
    "endpoint_name": "endpoint",
    "environment_evolution_insert_before": "        -- Fixed damage",
    "memory_declaration_after_var": "complete"
