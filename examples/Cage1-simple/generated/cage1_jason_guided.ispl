Agent Blue
    Lobsvars = {user_decoy, enterprise_decoy, operational_decoy, activity_User0, activity_Enterprise0, activity_Defender, activity_Op_Host0, activity_Op_Server0, compromised_User0, compromised_Enterprise0, compromised_Defender, compromised_Op_Host0, compromised_Op_Server0};
    Vars:
        dummy : boolean;
        blue_goal_level: {secure_network, secure_Op_Server0, secure_Enterprise0, secure_Op_Host0, done};
    end Vars

    Actions = {
        sleep, monitor, analyse_User0, remove_User0, misinform_User0,
        restore_User0, analyse_Enterprise0, remove_Enterprise0, misinform_Enterprise0, restore_Enterprise0,
        analyse_Defender, remove_Defender, misinform_Defender, restore_Defender, analyse_Op_Host0,
        remove_Op_Host0, misinform_Op_Host0, restore_Op_Host0, analyse_Op_Server0, remove_Op_Server0,
        misinform_Op_Server0, restore_Op_Server0, blue_wait
    };
    Protocol:
        blue_goal_level = secure_network and Environment.compromised_Op_Server0 = no and Environment.compromised_Enterprise0 = no and Environment.compromised_Op_Host0 = no and Environment.turn = blue_turn: {monitor};
        blue_goal_level = secure_Op_Server0 and Environment.compromised_Op_Server0 = privileged and Environment.turn = blue_turn: {restore_Op_Server0};
        blue_goal_level = secure_Op_Server0 and Environment.compromised_Op_Server0 = user and !(Environment.compromised_Op_Server0 = privileged) and Environment.turn = blue_turn: {remove_Op_Server0};
        blue_goal_level = secure_Enterprise0 and Environment.compromised_Enterprise0 = privileged and Environment.turn = blue_turn: {restore_Enterprise0};
        blue_goal_level = secure_Enterprise0 and Environment.compromised_Enterprise0 = user and !(Environment.compromised_Enterprise0 = privileged) and Environment.turn = blue_turn: {remove_Enterprise0};
        blue_goal_level = secure_Op_Host0 and Environment.compromised_Op_Host0 = privileged and Environment.turn = blue_turn: {restore_Op_Host0};
        blue_goal_level = secure_Op_Host0 and Environment.compromised_Op_Host0 = user and !(Environment.compromised_Op_Host0 = privileged) and Environment.turn = blue_turn: {remove_Op_Host0};
        Environment.turn = red_turn: {blue_wait};
        Environment.turn = blue_turn: {restore_Op_Server0};
        Other: {monitor};
    end Protocol
    Evolution:
        dummy = dummy if dummy = true;
        dummy = dummy if dummy = false;
        blue_goal_level = secure_Op_Server0 if blue_goal_level = secure_network and !(Environment.compromised_Op_Server0 = no);
        blue_goal_level = secure_Enterprise0 if blue_goal_level = secure_network and !(Environment.compromised_Enterprise0 = no) and Environment.compromised_Op_Server0 = no;
        blue_goal_level = secure_Op_Host0 if blue_goal_level = secure_network and !(Environment.compromised_Op_Host0 = no) and Environment.compromised_Op_Server0 = no and Environment.compromised_Enterprise0 = no;
        blue_goal_level = secure_network if blue_goal_level = secure_Enterprise0 and !(Environment.compromised_Enterprise0 = privileged) and !(Environment.compromised_Enterprise0 = user);
        blue_goal_level = secure_network if blue_goal_level = secure_Op_Host0 and !(Environment.compromised_Op_Host0 = privileged) and !(Environment.compromised_Op_Host0 = user);
        blue_goal_level = secure_network if blue_goal_level = secure_Op_Server0 and !(Environment.compromised_Op_Server0 = privileged) and !(Environment.compromised_Op_Server0 = user);
        blue_goal_level = secure_network if blue_goal_level = secure_Enterprise0 and Blue.Action = restore_Enterprise0;
        blue_goal_level = secure_network if blue_goal_level = secure_Enterprise0 and Blue.Action = remove_Enterprise0;
        blue_goal_level = secure_network if blue_goal_level = secure_Op_Host0 and Blue.Action = restore_Op_Host0;
        blue_goal_level = secure_network if blue_goal_level = secure_Op_Host0 and Blue.Action = remove_Op_Host0;
        blue_goal_level = secure_network if blue_goal_level = secure_Op_Server0 and Blue.Action = restore_Op_Server0;
        blue_goal_level = secure_network if blue_goal_level = secure_Op_Server0 and Blue.Action = remove_Op_Server0;
    end Evolution
end Agent


Agent Red
    Lobsvars = {red_User0, red_Enterprise0, red_Defender, red_Op_Host0, red_Op_Server0};
    Vars:
        dummy : boolean;
    end Vars

    Actions = {
        Sleep, DiscoverRemoteSystems_User, DiscoverRemoteSystems_Enterprise, DiscoverRemoteSystems_Operational, DiscoverNetworkServices_User0,
        ExploitRemoteService_User0, PrivilegeEscalate_User0, DiscoverNetworkServices_Enterprise0, ExploitRemoteService_Enterprise0, PrivilegeEscalate_Enterprise0,
        DiscoverNetworkServices_Defender, ExploitRemoteService_Defender, PrivilegeEscalate_Defender, DiscoverNetworkServices_Op_Host0, ExploitRemoteService_Op_Host0,
        PrivilegeEscalate_Op_Host0, DiscoverNetworkServices_Op_Server0, ExploitRemoteService_Op_Server0, PrivilegeEscalate_Op_Server0, Impact_Op_Server0,
        RedWait
    };
    Protocol:
        Environment.turn = blue_turn : {RedWait};
        Environment.turn = red_turn : {Sleep, DiscoverRemoteSystems_User, DiscoverRemoteSystems_Enterprise};
        Environment.turn = red_turn and Environment.red_Enterprise0 = root : {DiscoverRemoteSystems_Operational};
        Environment.turn = red_turn and Environment.red_User0 = known : {DiscoverNetworkServices_User0};
        Environment.turn = red_turn and Environment.red_User0 = service : {ExploitRemoteService_User0};
        Environment.turn = red_turn and Environment.red_User0 = user : {PrivilegeEscalate_User0};
        Environment.turn = red_turn and Environment.red_Enterprise0 = known : {DiscoverNetworkServices_Enterprise0};
        Environment.turn = red_turn and Environment.red_Enterprise0 = service : {ExploitRemoteService_Enterprise0};
        Environment.turn = red_turn and Environment.red_Enterprise0 = user : {PrivilegeEscalate_Enterprise0};
        Environment.turn = red_turn and Environment.red_Defender = known : {DiscoverNetworkServices_Defender};
        Environment.turn = red_turn and Environment.red_Defender = service : {ExploitRemoteService_Defender};
        Environment.turn = red_turn and Environment.red_Defender = user : {PrivilegeEscalate_Defender};
        Environment.turn = red_turn and Environment.red_Op_Host0 = known : {DiscoverNetworkServices_Op_Host0};
        Environment.turn = red_turn and Environment.red_Op_Host0 = service : {ExploitRemoteService_Op_Host0};
        Environment.turn = red_turn and Environment.red_Op_Host0 = user : {PrivilegeEscalate_Op_Host0};
        Environment.turn = red_turn and Environment.red_Op_Server0 = known : {DiscoverNetworkServices_Op_Server0};
        Environment.turn = red_turn and Environment.red_Op_Server0 = service : {ExploitRemoteService_Op_Server0};
        Environment.turn = red_turn and Environment.red_Op_Server0 = user : {PrivilegeEscalate_Op_Server0};
        Environment.turn = red_turn and Environment.red_Op_Server0 = root : {Impact_Op_Server0};
    end Protocol
    Evolution:
        dummy = dummy if dummy = true;
        dummy = dummy if dummy = false;
    end Evolution
end Agent

Evaluation
    Enterprise0_root if Environment.actual_Enterprise0 = root;
    OpServer_root if Environment.actual_Op_Server0 = root;
    OTService_running if Environment.ot_service_running = true;
    OTService_impacted if Environment.ot_service_running = false;
end Evaluation

InitStates
    Environment.turn = blue_turn and
    Environment.user_decoy = none and
    Environment.enterprise_decoy = none and
    Environment.operational_decoy = none and
    Environment.ot_service_running = true and
    Environment.activity_User0 = suspicious and
    Environment.compromised_User0 = privileged and
    Environment.activity_Enterprise0 = none and
    Environment.compromised_Enterprise0 = no and
    Environment.activity_Defender = none and
    Environment.compromised_Defender = no and
    Environment.activity_Op_Host0 = none and
    Environment.compromised_Op_Host0 = no and
    Environment.activity_Op_Server0 = none and
    Environment.compromised_Op_Server0 = no and
    Environment.actual_User0 = root and
    Environment.red_User0 = root and
    Environment.actual_Enterprise0 = clean and
    Environment.red_Enterprise0 = unknown and
    Environment.actual_Defender = clean and
    Environment.red_Defender = unknown and
    Environment.actual_Op_Host0 = clean and
    Environment.red_Op_Host0 = unknown and
    Environment.actual_Op_Server0 = clean and
    Environment.red_Op_Server0 = unknown and
    Blue.blue_goal_level = secure_network and
    Blue.dummy = false and
    Red.dummy = false;
end InitStates

Groups
    blue_team = {Blue};
    red_team = {Red};
end Groups

Formulae
    EF Enterprise0_root;
    EF OpServer_root;
    EF OTService_impacted;
    <red_team> F OTService_impacted;
    <blue_team> G OTService_running;
end Formulae
