Semantics=SingleAssignment;

Agent Environment
    Obsvars:
        turn : {blue_turn, red_turn};
    end Obsvars
    Vars:
        user_decoy : {none, d_User0};
        enterprise_decoy : {none, d_Enterprise0, d_Defender};
        operational_decoy : {none, d_Op_Host0, d_Op_Server0};
