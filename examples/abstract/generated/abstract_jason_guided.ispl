        at_goal_level = saved_civilians and Environment.at_knows_buried_Civ = true and Environment.buried_Civ_reported_to_FB = true and Environment.alive_Civ = true and (Environment.buriedness_value_Civ = 1 or Environment.buriedness_value_Civ = 2 or Environment.buriedness_value_Civ = 3 or Environment.buriedness_value_Civ = 4 or Environment.buriedness_value_Civ = 5 or Environment.buriedness_value_Civ = 6) and Environment.at_zone = z_central_north:
            {at_move_to_z_west_north, at_move_to_z_central_mid, at_move_to_z_east_north, at_rest};
        at_goal_level = saved_civilians and Environment.at_knows_buried_Civ = true and Environment.buried_Civ_reported_to_FB = true and Environment.alive_Civ = true and (Environment.buriedness_value_Civ = 1 or Environment.buriedness_value_Civ = 2 or Environment.buriedness_value_Civ = 3 or Environment.buriedness_value_Civ = 4 or Environment.buriedness_value_Civ = 5 or Environment.buriedness_value_Civ = 6) and Environment.at_zone = z_central_mid:
            {at_move_to_z_east_mid, at_rest};
        at_goal_level = saved_civilians and Environment.at_knows_buried_Civ = true and Environment.buried_Civ_reported_to_FB = true and Environment.alive_Civ = true and (Environment.buriedness_value_Civ = 1 or Environment.buriedness_value_Civ = 2 or Environment.buriedness_value_Civ = 3 or Environment.buriedness_value_Civ = 4 or Environment.buriedness_value_Civ = 5 or Environment.buriedness_value_Civ = 6) and Environment.at_zone = z_east_north:
