    Environment.buried_Civ_reported_to_FB = false and
    Environment.Civ_ready_reported_to_AT = false and
    Environment.at_knows_refuge = false and
    FireBrigade.fb_goal_level = saved_civilians and
    FireBrigade.fb_visited_z_west_north = false and
    FireBrigade.fb_visited_z_west_mid = false and
    FireBrigade.fb_visited_z_west_south = false and
    FireBrigade.fb_visited_z_central_north = false and
    FireBrigade.fb_visited_z_central_mid = false and
    FireBrigade.fb_visited_z_central_south = false and
    FireBrigade.fb_visited_z_east_north = true and
    FireBrigade.fb_visited_z_east_mid = false and
    FireBrigade.fb_visited_z_east_south = false and
    AmbulanceTeam.at_goal_level = saved_civilians and
    AmbulanceTeam.at_visited_z_west_north = true and
    AmbulanceTeam.at_visited_z_west_mid = false and
    AmbulanceTeam.at_visited_z_west_south = false and
    AmbulanceTeam.at_visited_z_central_north = false and
    AmbulanceTeam.at_visited_z_central_mid = false and
    AmbulanceTeam.at_visited_z_central_south = false and
    AmbulanceTeam.at_visited_z_east_north = false and
    AmbulanceTeam.at_visited_z_east_mid = false and
    AmbulanceTeam.at_visited_z_east_south = false and
    FireBrigade.dummy = false and
    AmbulanceTeam.dummy = false;
end InitStates

Groups
