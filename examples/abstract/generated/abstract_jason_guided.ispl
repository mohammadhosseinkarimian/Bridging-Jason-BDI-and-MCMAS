        fb_goal_level = saved_civilians and Environment.fb_knows_buried_Civ = false and Environment.alive_Civ = true and Environment.fb_zone = z_central_north and fb_visited_z_west_north = true and fb_visited_z_central_mid = true and fb_visited_z_east_north = true:
