            {at_move_to_z_east_south};
        at_goal_level = saved_civilians and Environment.at_knows_buried_Civ = false and Environment.alive_Civ = true and Environment.at_zone = z_east_mid and at_visited_z_central_mid = true and at_visited_z_east_north = true and at_visited_z_east_south = true:
            {at_move_to_z_central_mid, at_move_to_z_east_north, at_move_to_z_east_south};
        at_goal_level = saved_civilians and Environment.at_knows_buried_Civ = false and Environment.alive_Civ = true and Environment.at_zone = z_east_south and at_visited_z_central_south = false:
            {at_move_to_z_central_south};
        at_goal_level = saved_civilians and Environment.at_knows_buried_Civ = false and Environment.alive_Civ = true and Environment.at_zone = z_east_south and at_visited_z_central_south = true and at_visited_z_east_mid = false:
            {at_move_to_z_east_mid};
        at_goal_level = saved_civilians and Environment.at_knows_buried_Civ = false and Environment.alive_Civ = true and Environment.at_zone = z_east_south and at_visited_z_central_south = true and at_visited_z_east_mid = true:
            {at_move_to_z_central_south, at_move_to_z_east_mid};
        Other: {at_rest};
    end Protocol
    Evolution:
        dummy = dummy if dummy = true;
        dummy = dummy if dummy = false;
        at_goal_level = done if Environment.dead_Civ = true;
        at_goal_level = done if at_goal_level = delivered and AmbulanceTeam.Action = at_unload_Civ;
        at_goal_level = delivered if at_goal_level = loaded and AmbulanceTeam.Action = at_load_Civ;
        at_goal_level = loaded if at_goal_level = saved_civilians and Environment.alive_Civ = true and Environment.loaded_Civ = false and Environment.buriedness_value_Civ = 1 and Environment.at_zone = z_central_south and Environment.fb_zone = z_central_south and FireBrigade.Action = fb_rescue_Civ;
        at_goal_level = loaded if at_goal_level = saved_civilians and Environment.alive_Civ = true and Environment.loaded_Civ = false and Environment.buriedness_value_Civ = 0 and (Environment.Civ_ready_reported_to_AT = true or Environment.at_zone = z_central_south);
        at_goal_level = told_fire if at_goal_level = saved_civilians and Environment.at_knows_buried_Civ = true and Environment.buried_Civ_reported_to_FB = false and Environment.alive_Civ = true and (Environment.buriedness_value_Civ = 1 or Environment.buriedness_value_Civ = 2 or Environment.buriedness_value_Civ = 3 or Environment.buriedness_value_Civ = 4 or Environment.buriedness_value_Civ = 5 or Environment.buriedness_value_Civ = 6) and (Environment.fb_zone = z_west_north or Environment.fb_zone = z_west_mid or Environment.fb_zone = z_west_south or Environment.fb_zone = z_central_north or Environment.fb_zone = z_central_mid or Environment.fb_zone = z_east_north or Environment.fb_zone = z_east_mid or Environment.fb_zone = z_east_south);
        at_goal_level = saved_civilians if at_goal_level = told_fire and AmbulanceTeam.Action = at_report_buried_Civ;
        -- Visited
        at_visited_z_west_north = true if at_visited_z_west_north = true or AmbulanceTeam.Action = at_move_to_z_west_north;
        at_visited_z_west_mid = true if at_visited_z_west_mid = true or AmbulanceTeam.Action = at_move_to_z_west_mid;
        at_visited_z_west_south = true if at_visited_z_west_south = true or AmbulanceTeam.Action = at_move_to_z_west_south;
        at_visited_z_central_north = true if at_visited_z_central_north = true or AmbulanceTeam.Action = at_move_to_z_central_north;
        at_visited_z_central_mid = true if at_visited_z_central_mid = true or AmbulanceTeam.Action = at_move_to_z_central_mid;
        at_visited_z_central_south = true if at_visited_z_central_south = true or AmbulanceTeam.Action = at_move_to_z_central_south;
        at_visited_z_east_north = true if at_visited_z_east_north = true or AmbulanceTeam.Action = at_move_to_z_east_north;
        at_visited_z_east_mid = true if at_visited_z_east_mid = true or AmbulanceTeam.Action = at_move_to_z_east_mid;
        at_visited_z_east_south = true if at_visited_z_east_south = true or AmbulanceTeam.Action = at_move_to_z_east_south;
    end Evolution
end Agent


Evaluation
    Civ_complete if Environment.health_Civ = complete;
    Civ_high if Environment.health_Civ = high;
    Civ_moderate if Environment.health_Civ = moderate;
    Civ_at_risk if Environment.health_Civ = at_risk;
    Civ_dead if Environment.dead_Civ = true;
    Civ_deep if Environment.buriedness_value_Civ = 4 or Environment.buriedness_value_Civ = 5 or Environment.buriedness_value_Civ = 6;
    Civ_shallow if Environment.buriedness_value_Civ = 1 or Environment.buriedness_value_Civ = 2 or Environment.buriedness_value_Civ = 3;
    surface_Civ_eval if Environment.alive_Civ = true and Environment.buriedness_value_Civ = 0 and Environment.loaded_Civ = false and Environment.delivered_Civ = false;
    loaded_Civ_eval if Environment.loaded_Civ = true;
    rescued_Civ_eval if Environment.alive_Civ = true and Environment.buriedness_value_Civ = 0;
    delivered_alive_Civ_eval if Environment.delivered_Civ = true and Environment.alive_Civ = true and Environment.dead_Civ = false and Environment.loaded_Civ = false and Environment.at_Civ = z_west_mid and Environment.at_zone = z_west_mid;
    terminal_dead_Civ_eval if Environment.dead_Civ = true;
    terminal_Civ_eval if Environment.dead_Civ = true or (Environment.delivered_Civ = true and Environment.alive_Civ = true and Environment.dead_Civ = false and Environment.loaded_Civ = false and Environment.at_Civ = z_west_mid and Environment.at_zone = z_west_mid);
    fb_at_target_960 if Environment.fb_zone = z_central_south;
    at_at_target_960 if Environment.at_zone = z_central_south;
    at_refuge_249 if Environment.at_zone = z_west_mid;
end Evaluation

