            {at_move_to_z_east_south, at_rest};
        at_goal_level = saved_civilians and Environment.at_knows_buried_Civ = true and Environment.buried_Civ_reported_to_FB = true and Environment.alive_Civ = true and (Environment.buriedness_value_Civ = 1 or Environment.buriedness_value_Civ = 2 or Environment.buriedness_value_Civ = 3 or Environment.buriedness_value_Civ = 4 or Environment.buriedness_value_Civ = 5 or Environment.buriedness_value_Civ = 6) and Environment.at_zone = z_east_south:
            {at_move_to_z_central_south, at_rest};
        at_goal_level = saved_civilians and Environment.alive_Civ = true and Environment.loaded_Civ = false and Environment.buriedness_value_Civ = 0 and (Environment.Civ_ready_reported_to_AT = true or Environment.at_zone = z_central_south): {at_rest};
        -- Patrol
        at_goal_level = saved_civilians and Environment.at_knows_buried_Civ = false and Environment.alive_Civ = true and Environment.at_zone = z_west_north and at_visited_z_west_mid = false:
