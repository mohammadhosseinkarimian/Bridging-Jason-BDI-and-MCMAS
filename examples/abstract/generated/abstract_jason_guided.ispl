        at_goal_level = saved_civilians and Environment.at_knows_buried_Civ = false and Environment.alive_Civ = true and Environment.at_zone = z_west_north and at_visited_z_central_north = false:
            {at_move_to_z_central_north};
        at_goal_level = saved_civilians and Environment.at_knows_buried_Civ = false and Environment.alive_Civ = true and Environment.at_zone = z_west_north and at_visited_z_west_mid = true and at_visited_z_central_north = true:
            {at_move_to_z_west_mid, at_move_to_z_central_north};
        at_goal_level = saved_civilians and Environment.at_knows_buried_Civ = false and Environment.alive_Civ = true and Environment.at_zone = z_west_mid and at_visited_z_west_north = false:
