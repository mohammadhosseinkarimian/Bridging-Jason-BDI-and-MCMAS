        dummy = dummy if dummy = false;
        fb_goal_level = done if Environment.dead_Civ = true;
        fb_goal_level = done if Environment.loaded_Civ = true and Environment.alive_Civ = true and Environment.dead_Civ = false and Environment.delivered_Civ = false and Environment.at_zone = z_west_mid and Environment.at_zone = z_west_mid and AmbulanceTeam.Action = at_unload_Civ;
        fb_goal_level = told_ambulance if (fb_goal_level = saved_civilians or fb_goal_level = rescued_buried_civilian) and Environment.fb_knows_buried_Civ = true and Environment.alive_Civ = true and Environment.buriedness_value_Civ = 1 and Environment.fb_zone = z_central_south and FireBrigade.Action = fb_rescue_Civ;
        fb_goal_level = saved_civilians if fb_goal_level = told_ambulance and FireBrigade.Action = fb_notify_ambulance_ready_Civ and Environment.dead_Civ = false and Environment.delivered_Civ = false;
        fb_goal_level = rescued_buried_civilian if fb_goal_level = saved_civilians and Environment.fb_knows_buried_Civ = true and Environment.alive_Civ = true and (Environment.buriedness_value_Civ = 2 or Environment.buriedness_value_Civ = 3 or Environment.buriedness_value_Civ = 4 or Environment.buriedness_value_Civ = 5 or Environment.buriedness_value_Civ = 6);
        fb_goal_level = rescued_buried_civilian if fb_goal_level = rescued_buried_civilian and Environment.fb_knows_buried_Civ = true and Environment.alive_Civ = true and (Environment.buriedness_value_Civ = 2 or Environment.buriedness_value_Civ = 3 or Environment.buriedness_value_Civ = 4 or Environment.buriedness_value_Civ = 5 or Environment.buriedness_value_Civ = 6);
        -- Visited
        fb_visited_z_west_north = true if fb_visited_z_west_north = true or FireBrigade.Action = fb_move_to_z_west_north;
        fb_visited_z_west_mid = true if fb_visited_z_west_mid = true or FireBrigade.Action = fb_move_to_z_west_mid;
        fb_visited_z_west_south = true if fb_visited_z_west_south = true or FireBrigade.Action = fb_move_to_z_west_south;
        fb_visited_z_central_north = true if fb_visited_z_central_north = true or FireBrigade.Action = fb_move_to_z_central_north;
        fb_visited_z_central_mid = true if fb_visited_z_central_mid = true or FireBrigade.Action = fb_move_to_z_central_mid;
        fb_visited_z_central_south = true if fb_visited_z_central_south = true or FireBrigade.Action = fb_move_to_z_central_south;
        fb_visited_z_east_north = true if fb_visited_z_east_north = true or FireBrigade.Action = fb_move_to_z_east_north;
        fb_visited_z_east_mid = true if fb_visited_z_east_mid = true or FireBrigade.Action = fb_move_to_z_east_mid;
        fb_visited_z_east_south = true if fb_visited_z_east_south = true or FireBrigade.Action = fb_move_to_z_east_south;
    end Evolution
end Agent


