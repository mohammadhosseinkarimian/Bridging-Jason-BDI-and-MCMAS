Semantics=SingleAssignment;

Agent Environment
    Obsvars:
        did_action_FB: {none, fb_move_to_z_west_north, fb_move_to_z_west_mid, fb_move_to_z_west_south, fb_move_to_z_central_north, fb_move_to_z_central_mid, fb_move_to_z_central_south, fb_move_to_z_east_north, fb_move_to_z_east_mid, fb_move_to_z_east_south, fb_rescue_Civ, fb_rest};
        did_action_AT: {none, at_move_to_z_west_north, at_move_to_z_west_mid, at_move_to_z_west_south, at_move_to_z_central_north, at_move_to_z_central_mid, at_move_to_z_central_south, at_move_to_z_east_north, at_move_to_z_east_mid, at_move_to_z_east_south, at_load_Civ, at_unload_Civ, at_rest};
        fb_zone: {z_west_north, z_west_mid, z_west_south, z_central_north, z_central_mid, z_central_south, z_east_north, z_east_mid, z_east_south};
        at_zone: {z_west_north, z_west_mid, z_west_south, z_central_north, z_central_mid, z_central_south, z_east_north, z_east_mid, z_east_south};
        at_Civ: {z_west_north, z_west_mid, z_west_south, z_central_north, z_central_mid, z_central_south, z_east_north, z_east_mid, z_east_south, in_ambulance};
        status_z_west_north: {healthy, damaged, collapsed};
        status_z_west_mid: {healthy, damaged, collapsed};
        status_z_west_south: {healthy, damaged, collapsed};
        status_z_central_north: {healthy, damaged, collapsed};
        status_z_central_mid: {healthy, damaged, collapsed};
        status_z_central_south: {healthy, damaged, collapsed};
        status_z_east_north: {healthy, damaged, collapsed};
        status_z_east_mid: {healthy, damaged, collapsed};
        status_z_east_south: {healthy, damaged, collapsed};
        health_Civ: {complete, high, moderate, at_risk, dead};
        damage_Civ: {none, moderate};
        buriedness_value_Civ: 0 .. 6;
        health_clock: 0 .. 46;
        alive_Civ: boolean;
        dead_Civ: boolean;
        loaded_Civ: boolean;
        delivered_Civ: boolean;
        fb_knows_buried_Civ: boolean;
        at_knows_buried_Civ: boolean;
        buried_Civ_reported_to_FB: boolean;
        Civ_ready_reported_to_AT: boolean;
        at_knows_refuge: boolean;
    end Obsvars
    Actions = {env_idle};
    Protocol:
        Other: {env_idle};
    end Protocol
    Evolution:
        -- Actions
        did_action_FB = fb_move_to_z_west_north if FireBrigade.Action = fb_move_to_z_west_north;
        did_action_FB = fb_move_to_z_west_mid if FireBrigade.Action = fb_move_to_z_west_mid;
        did_action_FB = fb_move_to_z_west_south if FireBrigade.Action = fb_move_to_z_west_south;
        did_action_FB = fb_move_to_z_central_north if FireBrigade.Action = fb_move_to_z_central_north;
        did_action_FB = fb_move_to_z_central_mid if FireBrigade.Action = fb_move_to_z_central_mid;
        did_action_FB = fb_move_to_z_central_south if FireBrigade.Action = fb_move_to_z_central_south;
        did_action_FB = fb_move_to_z_east_north if FireBrigade.Action = fb_move_to_z_east_north;
        did_action_FB = fb_move_to_z_east_mid if FireBrigade.Action = fb_move_to_z_east_mid;
        did_action_FB = fb_move_to_z_east_south if FireBrigade.Action = fb_move_to_z_east_south;
        did_action_FB = fb_rescue_Civ if FireBrigade.Action = fb_rescue_Civ;
        did_action_FB = fb_rest if FireBrigade.Action = fb_rest;
        did_action_AT = at_move_to_z_west_north if AmbulanceTeam.Action = at_move_to_z_west_north;
        did_action_AT = at_move_to_z_west_mid if AmbulanceTeam.Action = at_move_to_z_west_mid;
        did_action_AT = at_move_to_z_west_south if AmbulanceTeam.Action = at_move_to_z_west_south;
        did_action_AT = at_move_to_z_central_north if AmbulanceTeam.Action = at_move_to_z_central_north;
        did_action_AT = at_move_to_z_central_mid if AmbulanceTeam.Action = at_move_to_z_central_mid;
        did_action_AT = at_move_to_z_central_south if AmbulanceTeam.Action = at_move_to_z_central_south;
        did_action_AT = at_move_to_z_east_north if AmbulanceTeam.Action = at_move_to_z_east_north;
        did_action_AT = at_move_to_z_east_mid if AmbulanceTeam.Action = at_move_to_z_east_mid;
        did_action_AT = at_move_to_z_east_south if AmbulanceTeam.Action = at_move_to_z_east_south;
        did_action_AT = at_load_Civ if AmbulanceTeam.Action = at_load_Civ;
        did_action_AT = at_unload_Civ if AmbulanceTeam.Action = at_unload_Civ;
        did_action_AT = at_rest if AmbulanceTeam.Action = at_rest;
        -- Movement
        fb_zone = z_west_north if FireBrigade.Action = fb_move_to_z_west_north;
        fb_zone = z_west_mid if FireBrigade.Action = fb_move_to_z_west_mid;
        fb_zone = z_west_south if FireBrigade.Action = fb_move_to_z_west_south;
        fb_zone = z_central_north if FireBrigade.Action = fb_move_to_z_central_north;
        fb_zone = z_central_mid if FireBrigade.Action = fb_move_to_z_central_mid;
        fb_zone = z_central_south if FireBrigade.Action = fb_move_to_z_central_south;
        fb_zone = z_east_north if FireBrigade.Action = fb_move_to_z_east_north;
        fb_zone = z_east_mid if FireBrigade.Action = fb_move_to_z_east_mid;
        fb_zone = z_east_south if FireBrigade.Action = fb_move_to_z_east_south;
        fb_zone = fb_zone if FireBrigade.Action = fb_rescue_Civ;
        fb_zone = fb_zone if FireBrigade.Action = fb_notify_ambulance_ready_Civ;
        fb_zone = fb_zone if FireBrigade.Action = fb_rest;
        at_zone = z_west_north if AmbulanceTeam.Action = at_move_to_z_west_north;
        at_zone = z_west_mid if AmbulanceTeam.Action = at_move_to_z_west_mid;
        at_zone = z_west_south if AmbulanceTeam.Action = at_move_to_z_west_south;
        at_zone = z_central_north if AmbulanceTeam.Action = at_move_to_z_central_north;
        at_zone = z_central_mid if AmbulanceTeam.Action = at_move_to_z_central_mid;
        at_zone = z_central_south if AmbulanceTeam.Action = at_move_to_z_central_south;
        at_zone = z_east_north if AmbulanceTeam.Action = at_move_to_z_east_north;
        at_zone = z_east_mid if AmbulanceTeam.Action = at_move_to_z_east_mid;
        at_zone = z_east_south if AmbulanceTeam.Action = at_move_to_z_east_south;
        at_zone = at_zone if AmbulanceTeam.Action = at_load_Civ;
        at_zone = at_zone if AmbulanceTeam.Action = at_unload_Civ;
        at_zone = at_zone if AmbulanceTeam.Action = at_report_buried_Civ;
        at_zone = at_zone if AmbulanceTeam.Action = at_rest;
        -- Rescue
        buriedness_value_Civ = 5 if alive_Civ = true and buriedness_value_Civ = 6 and at_Civ = z_central_south and fb_zone = z_central_south and FireBrigade.Action = fb_rescue_Civ;
        buriedness_value_Civ = 4 if alive_Civ = true and buriedness_value_Civ = 5 and at_Civ = z_central_south and fb_zone = z_central_south and FireBrigade.Action = fb_rescue_Civ;
        buriedness_value_Civ = 3 if alive_Civ = true and buriedness_value_Civ = 4 and at_Civ = z_central_south and fb_zone = z_central_south and FireBrigade.Action = fb_rescue_Civ;
        buriedness_value_Civ = 2 if alive_Civ = true and buriedness_value_Civ = 3 and at_Civ = z_central_south and fb_zone = z_central_south and FireBrigade.Action = fb_rescue_Civ;
        buriedness_value_Civ = 1 if alive_Civ = true and buriedness_value_Civ = 2 and at_Civ = z_central_south and fb_zone = z_central_south and FireBrigade.Action = fb_rescue_Civ;
        buriedness_value_Civ = 0 if alive_Civ = true and buriedness_value_Civ = 1 and at_Civ = z_central_south and fb_zone = z_central_south and FireBrigade.Action = fb_rescue_Civ;
        -- Load
        loaded_Civ = true if alive_Civ = true and delivered_Civ = false and buriedness_value_Civ = 0 and at_Civ = z_central_south and at_zone = z_central_south and AmbulanceTeam.Action = at_load_Civ;
        at_Civ = in_ambulance if alive_Civ = true and delivered_Civ = false and buriedness_value_Civ = 0 and at_Civ = z_central_south and at_zone = z_central_south and AmbulanceTeam.Action = at_load_Civ;
        -- Unload
        loaded_Civ = false if loaded_Civ = true and alive_Civ = true and delivered_Civ = false and at_zone = z_west_mid and (health_Civ = complete or health_Civ = high or health_Civ = moderate or (health_Civ = at_risk and (health_clock = 0 or health_clock = 1 or health_clock = 2 or health_clock = 3 or health_clock = 4 or health_clock = 5 or health_clock = 6 or health_clock = 7 or health_clock = 8 or health_clock = 9 or health_clock = 10 or health_clock = 11 or health_clock = 12 or health_clock = 13 or health_clock = 14 or health_clock = 15 or health_clock = 16 or health_clock = 17 or health_clock = 18 or health_clock = 19 or health_clock = 20 or health_clock = 21 or health_clock = 22 or health_clock = 23 or health_clock = 24 or health_clock = 25 or health_clock = 26 or health_clock = 27 or health_clock = 28 or health_clock = 29 or health_clock = 30 or health_clock = 31 or health_clock = 32 or health_clock = 33 or health_clock = 34 or health_clock = 35 or health_clock = 36 or health_clock = 37 or health_clock = 38 or health_clock = 39 or health_clock = 40 or health_clock = 41 or health_clock = 42 or health_clock = 43 or health_clock = 44 or health_clock = 45))) and AmbulanceTeam.Action = at_unload_Civ;
        delivered_Civ = true if loaded_Civ = true and alive_Civ = true and delivered_Civ = false and at_zone = z_west_mid and (health_Civ = complete or health_Civ = high or health_Civ = moderate or (health_Civ = at_risk and (health_clock = 0 or health_clock = 1 or health_clock = 2 or health_clock = 3 or health_clock = 4 or health_clock = 5 or health_clock = 6 or health_clock = 7 or health_clock = 8 or health_clock = 9 or health_clock = 10 or health_clock = 11 or health_clock = 12 or health_clock = 13 or health_clock = 14 or health_clock = 15 or health_clock = 16 or health_clock = 17 or health_clock = 18 or health_clock = 19 or health_clock = 20 or health_clock = 21 or health_clock = 22 or health_clock = 23 or health_clock = 24 or health_clock = 25 or health_clock = 26 or health_clock = 27 or health_clock = 28 or health_clock = 29 or health_clock = 30 or health_clock = 31 or health_clock = 32 or health_clock = 33 or health_clock = 34 or health_clock = 35 or health_clock = 36 or health_clock = 37 or health_clock = 38 or health_clock = 39 or health_clock = 40 or health_clock = 41 or health_clock = 42 or health_clock = 43 or health_clock = 44 or health_clock = 45))) and AmbulanceTeam.Action = at_unload_Civ;
        at_Civ = z_west_mid if loaded_Civ = true and alive_Civ = true and delivered_Civ = false and at_zone = z_west_mid and (health_Civ = complete or health_Civ = high or health_Civ = moderate or (health_Civ = at_risk and (health_clock = 0 or health_clock = 1 or health_clock = 2 or health_clock = 3 or health_clock = 4 or health_clock = 5 or health_clock = 6 or health_clock = 7 or health_clock = 8 or health_clock = 9 or health_clock = 10 or health_clock = 11 or health_clock = 12 or health_clock = 13 or health_clock = 14 or health_clock = 15 or health_clock = 16 or health_clock = 17 or health_clock = 18 or health_clock = 19 or health_clock = 20 or health_clock = 21 or health_clock = 22 or health_clock = 23 or health_clock = 24 or health_clock = 25 or health_clock = 26 or health_clock = 27 or health_clock = 28 or health_clock = 29 or health_clock = 30 or health_clock = 31 or health_clock = 32 or health_clock = 33 or health_clock = 34 or health_clock = 35 or health_clock = 36 or health_clock = 37 or health_clock = 38 or health_clock = 39 or health_clock = 40 or health_clock = 41 or health_clock = 42 or health_clock = 43 or health_clock = 44 or health_clock = 45))) and AmbulanceTeam.Action = at_unload_Civ;
        -- Beliefs
        fb_knows_buried_Civ = true if fb_knows_buried_Civ = true or (alive_Civ = true and (buriedness_value_Civ = 1 or buriedness_value_Civ = 2 or buriedness_value_Civ = 3 or buriedness_value_Civ = 4 or buriedness_value_Civ = 5 or buriedness_value_Civ = 6) and at_Civ = z_central_south and (fb_zone = z_central_south or FireBrigade.Action = fb_move_to_z_central_south)) or buried_Civ_reported_to_FB = true;
        at_knows_buried_Civ = true if at_knows_buried_Civ = true or (alive_Civ = true and (buriedness_value_Civ = 1 or buriedness_value_Civ = 2 or buriedness_value_Civ = 3 or buriedness_value_Civ = 4 or buriedness_value_Civ = 5 or buriedness_value_Civ = 6) and at_Civ = z_central_south and (at_zone = z_central_south or AmbulanceTeam.Action = at_move_to_z_central_south));
        buried_Civ_reported_to_FB = true if buried_Civ_reported_to_FB = true or (at_knows_buried_Civ = true and AmbulanceTeam.Action = at_report_buried_Civ);
        Civ_ready_reported_to_AT = true if Civ_ready_reported_to_AT = true or (alive_Civ = true and buriedness_value_Civ = 0 and FireBrigade.Action = fb_notify_ambulance_ready_Civ);
        at_knows_refuge = true if at_knows_refuge = true or at_zone = z_west_mid or AmbulanceTeam.Action = at_move_to_z_west_mid;
        -- Health
        -- Progresses only while Civ is inside a collapsed zone
        health_clock = health_clock if delivered_Civ = true and dead_Civ = false;
        health_clock = health_clock if dead_Civ = true;
        health_clock = 10 if alive_Civ = true and delivered_Civ = false and dead_Civ = false and health_clock = 0 and ((at_Civ = z_west_north and status_z_west_north = collapsed) or (at_Civ = z_west_mid and status_z_west_mid = collapsed) or (at_Civ = z_west_south and status_z_west_south = collapsed) or (at_Civ = z_central_north and status_z_central_north = collapsed) or (at_Civ = z_central_mid and status_z_central_mid = collapsed) or (at_Civ = z_central_south and status_z_central_south = collapsed) or (at_Civ = z_east_north and status_z_east_north = collapsed) or (at_Civ = z_east_mid and status_z_east_mid = collapsed) or (at_Civ = z_east_south and status_z_east_south = collapsed)) and (FireBrigade.Action = fb_rescue_Civ);
        health_clock = 11 if alive_Civ = true and delivered_Civ = false and dead_Civ = false and health_clock = 1 and ((at_Civ = z_west_north and status_z_west_north = collapsed) or (at_Civ = z_west_mid and status_z_west_mid = collapsed) or (at_Civ = z_west_south and status_z_west_south = collapsed) or (at_Civ = z_central_north and status_z_central_north = collapsed) or (at_Civ = z_central_mid and status_z_central_mid = collapsed) or (at_Civ = z_central_south and status_z_central_south = collapsed) or (at_Civ = z_east_north and status_z_east_north = collapsed) or (at_Civ = z_east_mid and status_z_east_mid = collapsed) or (at_Civ = z_east_south and status_z_east_south = collapsed)) and (FireBrigade.Action = fb_rescue_Civ);
        health_clock = 12 if alive_Civ = true and delivered_Civ = false and dead_Civ = false and health_clock = 2 and ((at_Civ = z_west_north and status_z_west_north = collapsed) or (at_Civ = z_west_mid and status_z_west_mid = collapsed) or (at_Civ = z_west_south and status_z_west_south = collapsed) or (at_Civ = z_central_north and status_z_central_north = collapsed) or (at_Civ = z_central_mid and status_z_central_mid = collapsed) or (at_Civ = z_central_south and status_z_central_south = collapsed) or (at_Civ = z_east_north and status_z_east_north = collapsed) or (at_Civ = z_east_mid and status_z_east_mid = collapsed) or (at_Civ = z_east_south and status_z_east_south = collapsed)) and (FireBrigade.Action = fb_rescue_Civ);
        health_clock = 13 if alive_Civ = true and delivered_Civ = false and dead_Civ = false and health_clock = 3 and ((at_Civ = z_west_north and status_z_west_north = collapsed) or (at_Civ = z_west_mid and status_z_west_mid = collapsed) or (at_Civ = z_west_south and status_z_west_south = collapsed) or (at_Civ = z_central_north and status_z_central_north = collapsed) or (at_Civ = z_central_mid and status_z_central_mid = collapsed) or (at_Civ = z_central_south and status_z_central_south = collapsed) or (at_Civ = z_east_north and status_z_east_north = collapsed) or (at_Civ = z_east_mid and status_z_east_mid = collapsed) or (at_Civ = z_east_south and status_z_east_south = collapsed)) and (FireBrigade.Action = fb_rescue_Civ);
        health_clock = 14 if alive_Civ = true and delivered_Civ = false and dead_Civ = false and health_clock = 4 and ((at_Civ = z_west_north and status_z_west_north = collapsed) or (at_Civ = z_west_mid and status_z_west_mid = collapsed) or (at_Civ = z_west_south and status_z_west_south = collapsed) or (at_Civ = z_central_north and status_z_central_north = collapsed) or (at_Civ = z_central_mid and status_z_central_mid = collapsed) or (at_Civ = z_central_south and status_z_central_south = collapsed) or (at_Civ = z_east_north and status_z_east_north = collapsed) or (at_Civ = z_east_mid and status_z_east_mid = collapsed) or (at_Civ = z_east_south and status_z_east_south = collapsed)) and (FireBrigade.Action = fb_rescue_Civ);
        health_clock = 15 if alive_Civ = true and delivered_Civ = false and dead_Civ = false and health_clock = 5 and ((at_Civ = z_west_north and status_z_west_north = collapsed) or (at_Civ = z_west_mid and status_z_west_mid = collapsed) or (at_Civ = z_west_south and status_z_west_south = collapsed) or (at_Civ = z_central_north and status_z_central_north = collapsed) or (at_Civ = z_central_mid and status_z_central_mid = collapsed) or (at_Civ = z_central_south and status_z_central_south = collapsed) or (at_Civ = z_east_north and status_z_east_north = collapsed) or (at_Civ = z_east_mid and status_z_east_mid = collapsed) or (at_Civ = z_east_south and status_z_east_south = collapsed)) and (FireBrigade.Action = fb_rescue_Civ);
        health_clock = 16 if alive_Civ = true and delivered_Civ = false and dead_Civ = false and health_clock = 6 and ((at_Civ = z_west_north and status_z_west_north = collapsed) or (at_Civ = z_west_mid and status_z_west_mid = collapsed) or (at_Civ = z_west_south and status_z_west_south = collapsed) or (at_Civ = z_central_north and status_z_central_north = collapsed) or (at_Civ = z_central_mid and status_z_central_mid = collapsed) or (at_Civ = z_central_south and status_z_central_south = collapsed) or (at_Civ = z_east_north and status_z_east_north = collapsed) or (at_Civ = z_east_mid and status_z_east_mid = collapsed) or (at_Civ = z_east_south and status_z_east_south = collapsed)) and (FireBrigade.Action = fb_rescue_Civ);
        health_clock = 17 if alive_Civ = true and delivered_Civ = false and dead_Civ = false and health_clock = 7 and ((at_Civ = z_west_north and status_z_west_north = collapsed) or (at_Civ = z_west_mid and status_z_west_mid = collapsed) or (at_Civ = z_west_south and status_z_west_south = collapsed) or (at_Civ = z_central_north and status_z_central_north = collapsed) or (at_Civ = z_central_mid and status_z_central_mid = collapsed) or (at_Civ = z_central_south and status_z_central_south = collapsed) or (at_Civ = z_east_north and status_z_east_north = collapsed) or (at_Civ = z_east_mid and status_z_east_mid = collapsed) or (at_Civ = z_east_south and status_z_east_south = collapsed)) and (FireBrigade.Action = fb_rescue_Civ);
        health_clock = 18 if alive_Civ = true and delivered_Civ = false and dead_Civ = false and health_clock = 8 and ((at_Civ = z_west_north and status_z_west_north = collapsed) or (at_Civ = z_west_mid and status_z_west_mid = collapsed) or (at_Civ = z_west_south and status_z_west_south = collapsed) or (at_Civ = z_central_north and status_z_central_north = collapsed) or (at_Civ = z_central_mid and status_z_central_mid = collapsed) or (at_Civ = z_central_south and status_z_central_south = collapsed) or (at_Civ = z_east_north and status_z_east_north = collapsed) or (at_Civ = z_east_mid and status_z_east_mid = collapsed) or (at_Civ = z_east_south and status_z_east_south = collapsed)) and (FireBrigade.Action = fb_rescue_Civ);
        health_clock = 19 if alive_Civ = true and delivered_Civ = false and dead_Civ = false and health_clock = 9 and ((at_Civ = z_west_north and status_z_west_north = collapsed) or (at_Civ = z_west_mid and status_z_west_mid = collapsed) or (at_Civ = z_west_south and status_z_west_south = collapsed) or (at_Civ = z_central_north and status_z_central_north = collapsed) or (at_Civ = z_central_mid and status_z_central_mid = collapsed) or (at_Civ = z_central_south and status_z_central_south = collapsed) or (at_Civ = z_east_north and status_z_east_north = collapsed) or (at_Civ = z_east_mid and status_z_east_mid = collapsed) or (at_Civ = z_east_south and status_z_east_south = collapsed)) and (FireBrigade.Action = fb_rescue_Civ);
        health_clock = 20 if alive_Civ = true and delivered_Civ = false and dead_Civ = false and health_clock = 10 and ((at_Civ = z_west_north and status_z_west_north = collapsed) or (at_Civ = z_west_mid and status_z_west_mid = collapsed) or (at_Civ = z_west_south and status_z_west_south = collapsed) or (at_Civ = z_central_north and status_z_central_north = collapsed) or (at_Civ = z_central_mid and status_z_central_mid = collapsed) or (at_Civ = z_central_south and status_z_central_south = collapsed) or (at_Civ = z_east_north and status_z_east_north = collapsed) or (at_Civ = z_east_mid and status_z_east_mid = collapsed) or (at_Civ = z_east_south and status_z_east_south = collapsed)) and (FireBrigade.Action = fb_rescue_Civ);
        health_clock = 21 if alive_Civ = true and delivered_Civ = false and dead_Civ = false and health_clock = 11 and ((at_Civ = z_west_north and status_z_west_north = collapsed) or (at_Civ = z_west_mid and status_z_west_mid = collapsed) or (at_Civ = z_west_south and status_z_west_south = collapsed) or (at_Civ = z_central_north and status_z_central_north = collapsed) or (at_Civ = z_central_mid and status_z_central_mid = collapsed) or (at_Civ = z_central_south and status_z_central_south = collapsed) or (at_Civ = z_east_north and status_z_east_north = collapsed) or (at_Civ = z_east_mid and status_z_east_mid = collapsed) or (at_Civ = z_east_south and status_z_east_south = collapsed)) and (FireBrigade.Action = fb_rescue_Civ);
