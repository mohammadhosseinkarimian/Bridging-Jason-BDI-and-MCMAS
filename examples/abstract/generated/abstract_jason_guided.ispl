        fb_visited_z_east_north: boolean;
        fb_visited_z_east_mid: boolean;
        fb_visited_z_east_south: boolean;
    end Vars
    Actions = {
            fb_move_to_z_west_north, fb_move_to_z_west_mid, fb_move_to_z_west_south, fb_move_to_z_central_north, fb_move_to_z_central_mid, fb_move_to_z_central_south,
            fb_move_to_z_east_north, fb_move_to_z_east_mid, fb_move_to_z_east_south, fb_rescue_Civ, fb_notify_ambulance_ready_Civ, fb_rest
        };
    Protocol:
        (Environment.dead_Civ = true or (Environment.alive_Civ = true and Environment.dead_Civ = false and Environment.loaded_Civ = false and Environment.buriedness_value_Civ = 0 and Environment.at_Civ = z_west_mid and Environment.at_zone = z_west_mid and Environment.at_zone = z_west_mid)): {fb_rest};
        fb_goal_level = done: {fb_rest};
        fb_goal_level = told_ambulance: {fb_notify_ambulance_ready_Civ};
        (fb_goal_level = saved_civilians or fb_goal_level = rescued_buried_civilian) and Environment.fb_knows_buried_Civ = true and Environment.alive_Civ = true and (Environment.buriedness_value_Civ = 1 or Environment.buriedness_value_Civ = 2 or Environment.buriedness_value_Civ = 3 or Environment.buriedness_value_Civ = 4 or Environment.buriedness_value_Civ = 5 or Environment.buriedness_value_Civ = 6) and Environment.fb_zone = z_central_south: {fb_rescue_Civ};
        (fb_goal_level = saved_civilians or fb_goal_level = rescued_buried_civilian) and Environment.fb_knows_buried_Civ = true and Environment.alive_Civ = true and (Environment.buriedness_value_Civ = 1 or Environment.buriedness_value_Civ = 2 or Environment.buriedness_value_Civ = 3 or Environment.buriedness_value_Civ = 4 or Environment.buriedness_value_Civ = 5 or Environment.buriedness_value_Civ = 6) and Environment.fb_zone = z_west_north:
