{
  "files": {
    "raw": "../generated/custom2_raw.ispl",
    "output": "../generated/custom2_jason_guided.ispl"
  },
  "jason": {
    "vocabulary": {
      "actions": {
        "move": ["move_to"],
        "rescue": ["rescue"],
        "load": ["load"],
        "unload": ["unload"],
        "notify_ready": ["notify_ambulance_ready"],
        "notify_peer": ["notify_fire_needed"],
        "rest": ["rest"],
        "ignore": ["log", "radio_busy", "radio_done", "radio_loaded", "radio_found"]
      },
      "predicates": {
        "buried": ["buried_civilian", "buried_victim"],
        "surface": ["surface_civilian"],
        "ready": ["ready_for_ambulance", "ready_for_pickup", "fire_ready", "fire_done", "reported_transportable"],
        "loaded": ["loaded"],
        "delivered": ["delivered"],
        "found": ["found_civilian"],
        "reported_to_peer": ["told_fire"],
        "reported_ready": ["told_ambulance"],
        "collapsed": ["collapsed"],
        "damaged": ["damaged"],
        "building": ["building"],
        "road": ["road"],
        "known_road": ["known_road"],
        "visited": ["visited"],
        "destination": ["refuge", "found_refuge"]
      }
    },
    "roles": {
      "role_a": {
        "program": "../../../agents/fire_brigade.asl",
        "ispl_agent": "FireBrigade",
        "entry_goal": "step",
        "policy_kind": "target_operator",
        "location_var": "fb_area",
        "target_location": "target",
        "other_role": "role_b",
        "goal_var": "fb_goal_level",
        "visited_var_template": "fb_visited_{location}",
        "stages": [
          {"key": "work", "action_category": "rescue"},
          {"key": "notify", "action_category": "notify_ready"}
        ],
        "actions": {
          "move_template": "fb_move_to_{id}",
          "move_regex": "\\bfb_move_to_(\\d+)\\b",
          "move_destination_template": "area_{1}",
          "work": "fb_rescue_Civ",
          "notify": "fb_notify_ambulance_ready_Civ",
          "rest": "fb_rest"
        },
        "action_order": ["work", "notify", "rest"],
        "patrol": {
          "goal": "auto",
          "fallback_goal": "patrol",
          "signal_categories": ["collapsed", "damaged", "building", "road", "visited", "known_road"],
          "classifiers": [
            {"name": "found_buried", "all": ["found", "buried"]},
            {"name": "buried", "all": ["buried"]},
            {"name": "collapsed", "all": ["collapsed"]},
            {"name": "damaged", "all": ["damaged"]},
            {"name": "building", "all": ["building"]},
            {"name": "road_unvisited", "all": ["road"], "negative": ["visited"]},
            {"name": "road", "all": ["road"]},
            {"name": "rest", "context_equals": "true"}
          ],
          "fallback_order": ["collapsed", "damaged", "building", "road_unvisited", "road", "rest"],
          "class_categories": {
            "collapsed": ["collapsed"],
            "damaged": ["damaged"],
            "building": ["building"],
            "road": ["road_unvisited", "road", "known_road"]
          },
          "default_class": "road"
        }
      },
      "role_b": {
        "program": "../../../agents/ambulance_team.asl",
        "ispl_agent": "AmbulanceTeam",
        "entry_goal": "step",
        "policy_kind": "target_carrier",
        "location_var": "at_area",
        "target_location": "target",
        "other_role": "role_a",
        "goal_var": "at_goal_level",
        "visited_var_template": "at_visited_{location}",
        "stages": [
          {"key": "report", "action_category": "notify_peer"},
          {"key": "acquire", "action_category": "load"},
          {"key": "finish", "action_category": "unload"}
        ],
        "actions": {
          "move_template": "at_move_to_{id}",
          "move_regex": "\\bat_move_to_(\\d+)\\b",
          "move_destination_template": "area_{1}",
          "acquire": "at_load_Civ",
          "finish": "at_unload_Civ",
          "report": "at_report_buried_Civ",
          "rest": "at_rest"
        },
        "action_order": ["acquire", "finish", "report", "rest"],
        "patrol": {
          "goal": "auto",
          "fallback_goal": "patrol",
          "signal_categories": ["collapsed", "damaged", "building", "road", "visited", "known_road"],
          "classifiers": [
            {"name": "found_buried", "all": ["found", "buried"]},
            {"name": "buried", "all": ["buried"]},
            {"name": "loaded", "all": ["loaded"]},
            {"name": "known_road", "all": ["known_road"]},
            {"name": "collapsed", "all": ["collapsed"]},
            {"name": "damaged", "all": ["damaged"]},
            {"name": "building", "all": ["building"]},
            {"name": "road_unvisited", "all": ["road"], "negative": ["visited"]},
            {"name": "road", "all": ["road"]},
            {"name": "rest", "context_equals": "true"}
          ],
          "fallback_order": ["collapsed", "damaged", "building", "road_unvisited", "road", "rest"],
          "class_categories": {
            "collapsed": ["collapsed"],
            "damaged": ["damaged"],
            "building": ["building"],
            "road": ["road_unvisited", "road", "known_road"]
          },
          "default_class": "road"
        }
      }
    }
  },
  "model": {
    "environment_agent": "Environment",
    "location": {
      "enum_var": "fb_area",
      "value_regex": "area_\\d+",
      "token_regex": "area_(?P<id>\\d+)"
    },
    "named_locations": {
      "target": {"initial_var": "civ_area"},
      "destination": {"initial_var": "refuge_area"}
    },
    "variables": {
      "alive": "alive_Civ",
      "dead": "dead_Civ",
      "loaded": "loaded_Civ",
      "delivered": "delivered_Civ",
      "progress": "buriedness_value_Civ",
      "target_location_state": "civ_area",
      "destination_location_state": "refuge_area"
    },
    "progress": {
      "surface_value": 0,
      "final_active_value": 1,
      "positive_values": [1, 2, 3, 4, 5, 6],
      "continuing_values": [2, 3, 4, 5, 6]
    },
    "location_classes": {
      "default": "road",
      "rules": [
        {
          "declaration_regex": "\\bbuilding_{id}:\\s*boolean;",
          "state_regex": "Environment\\.brokenness_{id}\\s*=\\s*(?P<value>healthy|damaged|collapsed)",
          "value_map": {"healthy": "building", "damaged": "damaged", "collapsed": "collapsed"}
        }
      ]
    }
  },
  "coordination": {
    "operator_role": "role_a",
    "carrier_role": "role_b",
    "operator_knows_target_var": "fb_knows_buried_Civ",
    "carrier_knows_target_var": "at_knows_buried_Civ",
    "target_report_flag_var": "buried_Civ_reported_to_FB",
    "ready_report_flag_var": "Civ_ready_reported_to_AT",
    "carrier_knows_destination_var": "at_knows_refuge",
    "operator_work_action_key": "work",
    "operator_notify_action_key": "notify",
    "carrier_report_action_key": "report",
    "carrier_acquire_action_key": "acquire",
    "carrier_finish_action_key": "finish",
    "rest_action_key": "rest",
    "target_name": "target",
    "destination_name": "destination",
    "environment_evolution_insert_before": "        -- Fixed damage",
    "memory_declaration_after_var": "delivered"
  },
  "format": {
    "actions_indent": 12,
    "actions_per_line": 6,
    "path_indent": 16,
    "path_actions_per_line": 4
  }
}
